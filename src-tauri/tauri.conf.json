{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iodum",
  "version": "0.1.0",
  "identifier": "com.shieber.iodum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Iodum",
        "width": 1165,
        "height": 690,
        "minWidth": 1165,
        "minHeight": 690,
        "maxWidth": 1165,
        "maxHeight": 690,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"]
  }
}
